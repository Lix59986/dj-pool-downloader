# DJ Pool Downloader — Backend (Next.js)

# URL проекта в Supabase (панель: Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Публичный анонимный ключ (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role ключ — ТОЛЬКО на сервере (Project Settings → API → service_role), НЕ в клиентский код
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email первого администратора (используется для seed в миграции 001)
ADMIN_EMAIL=admin@example.com

# Разрешённый origin для CORS (домен PWA/продакшена). Пусто — разрешён любой (для разработки).
# Для расширения Chrome CORS не применяется (host_permissions), но preflight обрабатывается.
CORS_ORIGIN=
